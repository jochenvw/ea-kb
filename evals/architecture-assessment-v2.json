{
  "version": "2",
  "review_status": "provisional",
  "as_of": "2026-06-30",
  "obligation": "Synthetic Company obligation: hosted workloads apply the selected solution baseline.",
  "solution": {
    "name": "Evaluation solution",
    "owner": "Synthetic owner",
    "team": "synthetic-team",
    "repository": "example/evaluation",
    "environment": "production"
  },
  "context": {
    "exposure": "public",
    "criticality": "normal",
    "data_classification": "public",
    "environment": "production",
    "deployment_boundary": "internet"
  },
  "requirements": [
    {
      "key": "enc-web",
      "family": "encryption",
      "statement": "Synthetic: web endpoints accept only HTTPS with TLS 1.2 or later.",
      "options": [
        {
          "id": "https-tls12",
          "check_id": "encryption.in_transit",
          "resource_type": "Microsoft.Web/sites"
        }
      ]
    },
    {
      "key": "enc-legacy",
      "family": "encryption",
      "statement": "Synthetic: legacy protocol endpoints use approved gateways.",
      "excluded_reason": "No legacy protocol endpoints are in this baseline's scope.",
      "options": [
        {
          "id": "https-tls12",
          "check_id": "encryption.in_transit",
          "resource_type": "Microsoft.Web/sites"
        }
      ]
    },
    {
      "key": "log-web",
      "family": "logging",
      "statement": "Synthetic: web endpoints send diagnostic logs to a central workspace.",
      "options": [
        {
          "id": "diagnostic-settings",
          "check_id": "logging.diagnostic_settings",
          "resource_type": "Microsoft.Web/sites"
        }
      ]
    },
    {
      "key": "net-private",
      "family": "network",
      "statement": "Synthetic: private workloads disable public network access and use private endpoints.",
      "when": {
        "exposure": "private"
      },
      "options": [
        {
          "id": "private-endpoint",
          "check_id": "network.private_access",
          "resource_type": "Microsoft.Web/sites"
        }
      ]
    },
    {
      "key": "net-ddos",
      "family": "network",
      "statement": "Synthetic: virtual networks enable DDoS Network Protection with an associated protection plan.",
      "options": [
        {
          "id": "ddos-network-protection",
          "check_id": "network.ddos_protection",
          "resource_type": "Microsoft.Network/virtualNetworks"
        }
      ]
    },
    {
      "key": "id-auth",
      "family": "identity",
      "statement": "Synthetic: private workloads admit only authenticated or privately routed requests.",
      "when": {
        "exposure": "private"
      },
      "options": [
        {
          "id": "platform-auth",
          "check_id": "identity.require_authentication",
          "resource_type": "Microsoft.Web/sites"
        },
        {
          "id": "private-only",
          "check_id": "network.private_access",
          "resource_type": "Microsoft.Web/sites"
        }
      ]
    },
    {
      "key": "id-keys",
      "family": "identity",
      "statement": "Synthetic: data stores disable shared-key administrative access.",
      "options": [
        {
          "id": "directory-only",
          "check_id": "identity.shared_key_disabled",
          "resource_type": "Microsoft.Storage/storageAccounts"
        }
      ]
    },
    {
      "key": "ret-blob",
      "family": "retention",
      "statement": "Synthetic: confidential content keeps deleted blobs recoverable for at least seven days.",
      "when": {
        "data_classification": "confidential"
      },
      "options": [
        {
          "id": "soft-delete",
          "check_id": "retention.blob_soft_delete",
          "resource_type": "Microsoft.Storage/storageAccounts/blobServices"
        }
      ]
    },
    {
      "key": "sec-rotation",
      "family": "secrets",
      "statement": "Synthetic: high-criticality workloads rotate vault secrets automatically.",
      "when": {
        "criticality": "high"
      },
      "options": [
        {
          "id": "vault-rotation",
          "check_id": "secrets.rotation",
          "resource_type": "Microsoft.KeyVault/vaults"
        }
      ]
    }
  ],
  "templates": {
    "web": {
      "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "httpsOnly": {
          "type": "bool",
          "defaultValue": true
        },
        "tls": {
          "type": "string",
          "defaultValue": "1.2"
        },
        "publicAccess": {
          "type": "string",
          "defaultValue": "Enabled"
        },
        "privateEndpoint": {
          "type": "bool",
          "defaultValue": false
        },
        "auth": {
          "type": "bool",
          "defaultValue": false
        },
        "diagnostics": {
          "type": "bool",
          "defaultValue": true
        },
        "sharedKey": {
          "type": "bool",
          "defaultValue": false
        },
        "softDays": {
          "type": "int",
          "defaultValue": 7
        }
      },
      "resources": [
        {
          "type": "Microsoft.Web/sites",
          "apiVersion": "2023-12-01",
          "name": "web-0",
          "tags": {
            "note": "Synthetic: httpsOnly true and TLS 1.2 claimed here is not evidence."
          },
          "properties": {
            "httpsOnly": "[parameters('httpsOnly')]",
            "publicNetworkAccess": "[parameters('publicAccess')]",
            "siteConfig": {
              "minTlsVersion": "[parameters('tls')]"
            }
          }
        },
        {
          "type": "Microsoft.Web/sites/config",
          "apiVersion": "2023-12-01",
          "name": "web-0/authsettingsV2",
          "condition": "[parameters('auth')]",
          "properties": {
            "platform": {
              "enabled": true
            },
            "globalValidation": {
              "requireAuthentication": true
            }
          }
        },
        {
          "type": "Microsoft.Insights/diagnosticSettings",
          "apiVersion": "2021-05-01-preview",
          "name": "web-0-logs",
          "scope": "[resourceId('Microsoft.Web/sites', 'web-0')]",
          "condition": "[parameters('diagnostics')]",
          "properties": {
            "workspaceId": "synthetic-workspace",
            "logs": [
              {
                "category": "AppServiceHTTPLogs",
                "enabled": true
              }
            ]
          }
        },
        {
          "type": "Microsoft.Network/privateEndpoints",
          "apiVersion": "2023-11-01",
          "name": "web-0-pe",
          "condition": "[parameters('privateEndpoint')]",
          "properties": {
            "privateLinkServiceConnections": [
              {
                "name": "web",
                "properties": {
                  "privateLinkServiceId": "[resourceId('Microsoft.Web/sites', 'web-0')]",
                  "groupIds": [
                    "sites"
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Microsoft.Storage/storageAccounts",
          "apiVersion": "2023-05-01",
          "name": "data0",
          "properties": {
            "allowSharedKeyAccess": "[parameters('sharedKey')]",
            "supportsHttpsTrafficOnly": true,
            "minimumTlsVersion": "TLS1_2"
          }
        },
        {
          "type": "Microsoft.Storage/storageAccounts/blobServices",
          "apiVersion": "2023-05-01",
          "name": "data0/default",
          "properties": {
            "deleteRetentionPolicy": {
              "enabled": true,
              "days": "[parameters('softDays')]"
            }
          }
        }
      ]
    },
    "fleet": {
      "parameters": {
        "tls": {
          "type": "array",
          "defaultValue": [
            "1.2",
            "1.2",
            "1.0"
          ]
        }
      },
      "resources": [
        {
          "type": "Microsoft.Web/sites",
          "name": "[format('web-{0}', copyIndex())]",
          "copy": {
            "name": "sites",
            "count": 3
          },
          "properties": {
            "httpsOnly": true,
            "siteConfig": {
              "minTlsVersion": "[parameters('tls')[copyIndex()]]"
            }
          }
        }
      ]
    },
    "shared": {
      "resources": [
        {
          "type": "Microsoft.Storage/storageAccounts",
          "name": "shared-data",
          "existing": true
        }
      ]
    },
    "linked": {
      "resources": [
        {
          "type": "Microsoft.Web/sites",
          "name": "web-0",
          "properties": {
            "httpsOnly": true,
            "siteConfig": {
              "minTlsVersion": "1.2"
            }
          }
        },
        {
          "type": "Microsoft.Resources/deployments",
          "name": "edge",
          "properties": {
            "templateLink": {
              "uri": "https://example.invalid/edge.json"
            }
          }
        }
      ]
    },
    "minimal": {
      "resources": [
        {
          "type": "Microsoft.Web/sites",
          "name": "web-0",
          "properties": {}
        }
      ]
    },
    "network": {
      "parameters": {
        "ddos": {
          "type": "bool",
          "defaultValue": true
        }
      },
      "resources": [
        {
          "type": "Microsoft.Network/ddosProtectionPlans",
          "name": "net-ddos"
        },
        {
          "type": "Microsoft.Network/virtualNetworks",
          "name": "net-0",
          "tags": {
            "note": "Synthetic: DDoS protection claimed here is not evidence."
          },
          "properties": {
            "enableDdosProtection": "[parameters('ddos')]",
            "ddosProtectionPlan": {
              "id": "[resourceId('Microsoft.Network/ddosProtectionPlans', 'net-ddos')]"
            }
          }
        }
      ]
    }
  },
