          "enabled": true
        },
        "globalValidation": {
          "requireAuthentication": true,
          "unauthenticatedClientAction": "RedirectToLoginPage"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', format('{0}-web', parameters('name')))]"
      ]
    },
