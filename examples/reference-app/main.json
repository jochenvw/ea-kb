      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('name')))]",
        "httpsOnly": true,
        "publicNetworkAccess": "[parameters('publicNetworkAccess')]",
        "siteConfig": {
