# Provisioning/authentication/network hardening are intentionally outside this milestone.
# Give the worker and web the same PostgreSQL, blob and model configuration.
EKB_CONFIG_FILE=config/azure.yaml
EKB_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/ekb?ssl=require
EKB_BLOB_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net
EKB_BLOB_CONTAINER=ekb
EKB_MODEL_ENDPOINT=https://RESOURCE.services.ai.azure.com/openai/v1
EKB_MODEL_ID=YOUR_DEPLOYMENT
EKB_MODEL_MANAGED_IDENTITY=true
EKB_AZURE_MONITOR_CONNECTION_STRING=
# Web command: ekb web --host 0.0.0.0
# Worker command: ekb worker --manifest sources/public.yaml
# Migration job: ekb init
