{
  "name": "ekb-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lock:feed": "node scripts/use-feed.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.json *.ts *.js *.html",
    "format:check": "prettier --check src tests scripts *.json *.ts *.js *.html",
    "test": "playwright test",
    "verify": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
