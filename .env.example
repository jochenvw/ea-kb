EKB_DATABASE_URL=postgresql+asyncpg://ekb:ekb@localhost:5432/ekb
EKB_DATA_DIR=data
EKB_INFERENCE=rules
# rules is the limited offline baseline; agent-framework is preferred for model-backed skills.
EKB_MODEL_ENDPOINT=http://localhost:5272/v1
EKB_MODEL_ID=
# Optional cheaper labeling deployment on the same endpoint; blank reuses EKB_MODEL_ID.
EKB_LABELING_MODEL_ID=
EKB_MODEL_API_KEY=
EKB_MODEL_STRUCTURED_OUTPUT=false
EKB_MODEL_CONTEXT_TOKENS=32768
EKB_MODEL_MAX_OUTPUT_TOKENS=2048
EKB_MODEL_MAX_TOKEN_PARAMETER=max_tokens
EKB_MODEL_TEMPERATURE=0
# Reasoning models may require max_completion_tokens and temperature=null (omit temperature).
# EKB_RECONCILIATION_MODEL_ID=YOUR_DEPLOYMENT
# EKB_EMBEDDING_MODEL_ID=YOUR_EMBEDDING_DEPLOYMENT
# Per-million-token prices in consistent currency; unknown prices cannot qualify live cost.
# EKB_MODEL_INPUT_PRICE=0.0
# EKB_MODEL_OUTPUT_PRICE=0.0
# Separate prices are required when a labeling deployment override is selected.
# EKB_LABELING_INPUT_PRICE=0.0
# EKB_LABELING_OUTPUT_PRICE=0.0
# EKB_EMBEDDING_INPUT_PRICE=0.0
EKB_SEGMENT_MAX_CHARS=12000
EKB_SCAN_CONCURRENCY=4
EKB_PARSE_CONCURRENCY=2
EKB_MODEL_CONCURRENCY=2
EKB_OCR=false
EKB_ARTIFACT_BACKEND=filesystem
# EKB_BLOB_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net
# EKB_BLOB_CONTAINER=ekb
# EKB_AZURE_MONITOR_CONNECTION_STRING=
# EKB_DEBUG_ARTIFACTS=false
